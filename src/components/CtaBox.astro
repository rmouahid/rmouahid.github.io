---
import { Icon } from 'astro-icon/components';
import { getCtas } from '../lib/ctas';

const { box } = getCtas(import.meta.env.BASE_URL);
---

<div class="flex flex-col items-start justify-between gap-8 rounded border border-hairline bg-raised p-6 sm:p-10 md:flex-row md:items-center">
  <div class="max-w-xl space-y-3">
    <p class="eyebrow">{box.eyebrow}</p>
    <h2 class="font-serif text-2xl text-fg sm:text-3xl">{box.title}</h2>
    <p class="text-sm leading-relaxed text-muted">{box.body}</p>
  </div>
  <div class="flex w-full flex-col items-stretch gap-3 sm:w-auto sm:flex-row sm:items-center">
    <a
      href={box.primary.href}
      class="flex items-center justify-center gap-2 rounded bg-accent px-5 py-2.5 font-mono text-xs font-semibold whitespace-nowrap text-on-accent transition-opacity hover:opacity-95"
    >
      <Icon name="lucide:mail" class="size-3.5" aria-hidden="true" />
      {box.primary.label}
    </a>
    <a
      href={box.secondary.href}
      class="flex items-center justify-center gap-2 rounded border border-outline px-5 py-2.5 font-mono text-xs whitespace-nowrap text-fg transition-colors hover:border-accent"
    >
      <Icon name="lucide:file-text" class="size-3.5 text-muted" aria-hidden="true" />
      {box.secondary.label}
    </a>
  </div>
</div>
