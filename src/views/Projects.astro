---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Layout from '../layouts/Layout.astro';
import { projectTags, sortProjects, tagKey } from '../lib/projects';

type Project = Pick<CollectionEntry<'projects'>, 'id' | 'data'>;

interface Props {
  projects: Project[];
}

const items = sortProjects(Astro.props.projects);
const tags = projectTags(items);
const count = items.length;
const chip =
  'tag-filter rounded border border-hairline bg-raised px-2.5 py-1 font-mono text-xs text-muted transition-colors hover:text-fg';
---

<Layout title="Projects" description="Case studies of AI, LLM, RAG and data projects by Rayân Mouahid.">
  <Section last>
    <SectionHeader
      eyebrow="Portfolio"
      title="Projects"
      level={1}
      description="Every project as a case study: problem, architecture, trade-offs, measured results and limitations."
    />

    {count === 0 ? (
      <p class="font-mono text-sm text-muted">No projects published yet.</p>
    ) : (
      <>
        <div class="mb-8 space-y-4">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <div class="relative w-full sm:w-72">
              <Icon
                name="lucide:search"
                class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-faint"
                aria-hidden="true"
              />
              <label for="project-search" class="sr-only">
                Search projects
              </label>
              <input
                id="project-search"
                type="search"
                autocomplete="off"
                placeholder={`Search ${count} projects…`}
                class="w-full rounded border border-hairline bg-raised py-2 pr-3 pl-9 font-mono text-xs text-fg transition-colors placeholder:text-faint focus:border-accent"
              />
            </div>
            <span
              id="project-count"
              class="self-start rounded border border-hairline bg-elevated px-2.5 py-1.5 font-mono text-xs whitespace-nowrap text-muted sm:self-auto"
              data-total={count}
            >
              {count} projects
            </span>
          </div>
          <div role="group" aria-label="Filter by tag" class="flex flex-wrap gap-2">
            <button type="button" class={chip} data-tag="" aria-pressed="true">
              All
            </button>
            {tags.map(tag => (
              <button type="button" class={chip} data-tag={tagKey(tag)} aria-pressed="false">
                {tag}
              </button>
            ))}
          </div>
        </div>

        <ul id="projects-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {items.map(project => (
            <ProjectCard project={project} headingLevel={2} />
          ))}
        </ul>
      </>
    )}
    <p id="no-results" class="mt-8 hidden font-mono text-sm text-muted">
      No project matches these filters.
    </p>
    <p id="search-status" class="sr-only" aria-live="polite"></p>
  </Section>

  <style>
    .tag-filter[aria-pressed='true'] {
      border-color: var(--color-outline);
      background: var(--color-elevated);
      color: var(--color-accent);
    }
  </style>

  <script>
    const input = document.getElementById('project-search') as HTMLInputElement | null;
    const status = document.getElementById('search-status');
    const empty = document.getElementById('no-results');
    const counter = document.getElementById('project-count');
    const cards = [...document.querySelectorAll<HTMLElement>('[data-project]')];
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('.tag-filter')];
    const known = new Set(buttons.map(button => button.dataset.tag ?? ''));
    let tag = '';

    const apply = () => {
      const query = input?.value.trim().toLowerCase() ?? '';
      let shown = 0;
      for (const card of cards) {
        const tags = (card.dataset.tags ?? '').split(' ');
        const match = (!tag || tags.includes(tag)) && (!query || (card.dataset.search ?? '').includes(query));
        card.hidden = !match;
        if (match) shown++;
      }
      for (const button of buttons) button.setAttribute('aria-pressed', String((button.dataset.tag ?? '') === tag));
      empty?.classList.toggle('hidden', shown > 0);
      const label = `${shown} ${shown === 1 ? 'project' : 'projects'}`;
      if (counter) counter.textContent = label;
      if (status) status.textContent = `${label} shown`;
    };

    const select = (next: string) => {
      tag = known.has(next) ? next : '';
      const url = new URL(window.location.href);
      if (tag) url.searchParams.set('tag', tag);
      else url.searchParams.delete('tag');
      history.replaceState(null, '', url);
      apply();
    };

    for (const button of buttons) button.addEventListener('click', () => select(button.dataset.tag ?? ''));
    input?.addEventListener('input', apply);

    // A shared link such as /projects?tag=rag opens with that filter.
    const initial = new URLSearchParams(window.location.search).get('tag') ?? '';
    if (initial) {
      tag = known.has(initial) ? initial : '';
      apply();
    }
  </script>
</Layout>
