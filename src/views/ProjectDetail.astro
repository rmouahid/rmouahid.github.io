---
import { Icon } from 'astro-icon/components';
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Lightbox from '../components/Lightbox.astro';
import Section from '../components/Section.astro';
import Layout from '../layouts/Layout.astro';
import { route } from '../lib/urls';

interface Props {
  project: Pick<CollectionEntry<'projects'>, 'id' | 'data'>;
  headings?: { depth: number; slug: string; text: string }[];
}

const { project, headings = [] } = Astro.props;
const { title, summary, tldr, tags, stack, repo, demo, cover, coverAlt, status, date } = project.data;
const base = import.meta.env.BASE_URL;
// The TL;DR comes from the frontmatter and always opens the case study.
const sections = [{ slug: 'tldr', text: 'TL;DR' }, ...headings.filter(heading => heading.depth === 2)];
const image = cover ? await getImage({ src: cover, width: 1600 }) : undefined;
const button =
  'flex items-center gap-1.5 rounded border border-outline px-3 py-1.5 font-mono text-xs text-fg transition-colors hover:border-accent';
---

<Layout title={title} description={summary} image={`/og/${project.id}.png`} type="article">
  <Section last>
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 font-mono text-xs text-muted">
      <a href={route('/projects', base)} class="hover:text-fg">
        Projects
      </a>
      <span aria-hidden="true" class="text-outline">
        /
      </span>
      <span aria-current="page" class="truncate text-fg">
        {title}
      </span>
    </nav>

    <header class="space-y-6 border-b border-hairline pb-10">
      <div class="space-y-3">
        <p class="eyebrow">{tags.join(' · ')}</p>
        <h1 class="font-serif text-3xl text-fg sm:text-4xl">{title}</h1>
        <p class="max-w-2xl text-base leading-relaxed text-muted">{summary}</p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a href={repo} class={button}>
          <Icon name="simple-icons:github" class="size-3" aria-hidden="true" />
          Source code
        </a>
        {demo && (
          <a href={demo} class={button}>
            Live demo
            <Icon name="lucide:arrow-up-right" class="size-3" aria-hidden="true" />
          </a>
        )}
        <span class="font-mono text-xs text-faint">
          {date.getFullYear()}
          {status === 'archived' && ' · archived'}
        </span>
      </div>
      <div class="space-y-2">
        <p class="font-mono text-[11px] tracking-wider text-faint uppercase">Stack</p>
        <ul class="flex flex-wrap gap-1.5" aria-label="Stack">
          {stack.map(item => (
            <li class="rounded border border-hairline bg-elevated px-1.5 py-0.5 font-mono text-[11px] text-muted">
              {item}
            </li>
          ))}
        </ul>
      </div>
    </header>

    {image && coverAlt && (
      <Lightbox id={`cover-${project.id}`} image={image.src} alt={coverAlt} openLabel="Full size" closeLabel="Close" />
    )}

    <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[1fr_12rem]">
      <article class="prose max-w-2xl min-w-0">
        <h2 id="tldr">TL;DR</h2>
        <ul class="tldr">
          {tldr.map(line => (
            <li>{line}</li>
          ))}
        </ul>
        <slot />
      </article>
      {sections.length > 1 && (
        <nav aria-label="On this page" class="order-first lg:order-last">
          <div class="rounded border border-hairline bg-raised p-4 lg:sticky lg:top-20">
            <p class="mb-3 font-mono text-[11px] tracking-wider text-faint uppercase">On this page</p>
            <ol class="flex flex-wrap gap-x-4 gap-y-2 font-mono text-xs lg:flex-col">
              {sections.map(heading => (
                <li>
                  <a href={`#${heading.slug}`} class="text-muted hover:text-accent">
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </nav>
      )}
    </div>

    <p class="mt-14 border-t border-hairline pt-6 font-mono text-xs">
      <a href={route('/projects', base)} class="inline-flex items-center gap-1.5 text-muted hover:text-fg">
        <Icon name="lucide:arrow-left" class="size-3" aria-hidden="true" />
        All projects
      </a>
    </p>
  </Section>

  <script>
    import '../scripts/mermaid';
    import '../scripts/scrollables';
  </script>
</Layout>
