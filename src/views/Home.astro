---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import ContactLinks from '../components/ContactLinks.astro';
import CtaBox from '../components/CtaBox.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TerminalMock from '../components/TerminalMock.astro';
import { site } from '../config/site';
import Layout from '../layouts/Layout.astro';
import { featuredProjects } from '../lib/projects';
import { route } from '../lib/urls';

type Project = Pick<CollectionEntry<'projects'>, 'id' | 'data'>;

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const featured = featuredProjects(projects);
---

<Layout>
  <Section class="pt-12 sm:pt-20">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="space-y-8 lg:col-span-6">
        <p class="inline-flex items-center gap-2 rounded border border-hairline bg-raised px-2.5 py-1 font-mono text-xs text-muted">
          <span class="size-1.5 shrink-0 rounded-full bg-success"></span>
          {site.availability}
        </p>
        <div class="space-y-4">
          <h1 class="font-serif text-4xl leading-[1.08] tracking-tight text-fg sm:text-5xl">{site.name}</h1>
          <p class="max-w-xl text-lg leading-relaxed text-fg">{site.tagline}</p>
          <p class="max-w-xl text-sm leading-relaxed text-muted">
            Each project below is a short case study: the problem, the architecture, the trade-offs, measured results
            and what is still missing. The code lives on GitHub.
          </p>
        </div>
        <ContactLinks />
      </div>
      <div class="lg:col-span-6">
        <TerminalMock projects={featured.map(project => project.id)} />
      </div>
    </div>
  </Section>

  {featured.length > 0 && (
    <Section>
      <SectionHeader
        eyebrow="Selected work"
        title="Featured projects"
        description="Three projects worth two minutes of your time."
        id="featured-projects"
      >
        <a
          href={route('/projects', import.meta.env.BASE_URL)}
          class="inline-flex items-center gap-1.5 self-start rounded border border-hairline bg-elevated px-2.5 py-1.5 font-mono text-xs whitespace-nowrap text-muted transition-colors hover:text-fg md:self-auto"
        >
          All {projects.length} projects
          <Icon name="lucide:arrow-right" class="size-3" aria-hidden="true" />
        </a>
      </SectionHeader>
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-labelledby="featured-projects">
        {featured.map(project => (
          <ProjectCard project={project} />
        ))}
      </ul>
    </Section>
  )}

  <Section last>
    <CtaBox />
  </Section>
</Layout>
