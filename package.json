{
  "name": "rmouahid-portfolio",
  "private": true,
  "type": "module",
  "description": "Portfolio of AI, LLM and RAG case studies by Rayân Mouahid, built on the Terminal Noir Astro theme.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "test:contracts": "node --test tests/ci.test.mjs tests/deploy.test.mjs tests/adoption.test.mjs tests/browser-matrix.test.mjs",
    "verify:imports": "node --test tests/verify-imports.test.mjs",
    "verify:matrix": "node scripts/verify-matrix.mjs",
    "verify": "npm run test:contracts && npm test && npm run check && npm run format:check && npm run verify:imports && npm run verify:matrix"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@iconify-json/lucide": "1.2.141",
    "@iconify-json/simple-icons": "1.2.99",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "7.4.1",
    "astro-icon": "1.2.0",
    "mermaid": "^11.17.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "es-module-lexer": "^3.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "version": "1.0.4"
}
